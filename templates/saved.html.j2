<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Saved stories — {{ paper.name }}</title>
<link rel="stylesheet" href="{{ root }}static/fonts.css?v={{ v }}">
<link rel="stylesheet" href="{{ root }}static/style.css?v={{ v }}">
</head>
<body>
<div class="wrap">
{% set ed = None %}
{% include "_masthead.html.j2" %}
<main class="saved-page" id="feed">
  <h1>Saved stories</h1>
  <p class="saved-help">Stories you save are kept in this browser on this device. They are not shared with anyone and do not sync to your other devices.</p>
  <div id="saved-list"></div>
  <p class="empty" id="saved-empty" hidden>Nothing saved yet. Tap the bookmark on any story (or press <kbd>s</kbd>) to keep it here.</p>
</main>
</div>
<script src="{{ root }}static/app.js?v={{ v }}"></script>
</body>
</html>
