{# Weekly podcast player. Works as a plain <audio> without JavaScript; static/player.js swaps in the custom controls. #}
<section class="listen" aria-label="Audio briefing" data-ep="{{ episode.date }}" data-title="{{ episode.title }}">
  <button class="listen-play" type="button" aria-label="Play {{ episode.title }}" hidden><span class="ms" aria-hidden="true">play_arrow</span></button>
  <div class="listen-body">
    <p class="listen-kicker"><span class="ms" aria-hidden="true">podcasts</span>{% if episode.start == episode.end %}{% if episode.is_current is not defined or episode.is_current %}Audio briefing{% else %}Latest audio briefing · {{ episode.range_label }}{% endif %}{% else %}Weekly briefing{% endif %} · {{ episode.minutes }} min</p>
    <p class="listen-title">{{ episode.title }}</p>
    <p class="listen-dek">{{ episode.dek }}</p>
    <div class="listen-track" hidden>
      <input type="range" class="listen-seek" min="0" max="{{ episode.seconds }}" value="0" step="1" aria-label="Position in episode">
      <span class="listen-time"><span class="listen-cur">0:00</span> / {{ episode.duration }}</span>
    </div>
    <audio class="listen-audio" controls preload="none" src="{{ root }}podcast/audio/{{ episode.file }}"></audio>
  </div>
  <div class="listen-tools">
    <button type="button" class="listen-skip" data-skip="-10" aria-label="Back 10 seconds" hidden><span class="ms" aria-hidden="true">replay_10</span></button>
    <button type="button" class="listen-skip" data-skip="30" aria-label="Forward 30 seconds" hidden><span class="ms" aria-hidden="true">forward_30</span></button>
    <button type="button" class="listen-speed" aria-label="Playback speed" hidden>1×</button>
    <a class="listen-notes" href="{{ root }}podcast/index.html#ep-{{ episode.date }}">Show notes</a>
  </div>
</section>
