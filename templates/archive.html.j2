<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archive — {{ paper.name }}</title>
<link rel="stylesheet" href="{{ root }}static/fonts.css?v={{ v }}">
<link rel="stylesheet" href="{{ root }}static/style.css?v={{ v }}">
</head>
<body>
<div class="wrap">
{% set ed = None %}
{% include "_masthead.html.j2" %}
<main class="archive">
  <h1>Past editions</h1>
  <ul>
  {% for a in archive %}
    <li><a href="editions/{{ a.date }}/index.html">
      <span class="a-date">{{ a.date_long }}</span>
      <span class="a-no">No. {{ a.no }}{% if a.express %} · Express{% endif %} · {{ a.count }} stories{% if a.briefings %} · {{ a.briefings }} briefing{{ 's' if a.briefings > 1 }}{% endif %}</span>
      <span class="a-lead">{{ a.lead }}</span></a></li>
  {% endfor %}
  </ul>
</main>
</div>
</body>
</html>
