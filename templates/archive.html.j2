<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archive — {{ paper.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400..700&family=Roboto+Serif:opsz,wght@8..144,500..800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=block" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}static/style.css?v={{ v }}">
</head>
<body>
<div class="wrap">
{% set ed = None %}
{% include "_masthead.html.j2" %}
<main class="archive">
  <h1>Past editions</h1>
  <ul>
  {% for a in archive %}
    <li><a href="editions/{{ a.date }}/index.html">
      <span class="a-date">{{ a.date_long }}</span>
      <span class="a-no">No. {{ a.no }}{% if a.express %} · Express{% endif %} · {{ a.count }} stories{% if a.briefings %} · {{ a.briefings }} briefing{{ 's' if a.briefings > 1 }}{% endif %}</span>
      <span class="a-lead">{{ a.lead }}</span></a></li>
  {% endfor %}
  </ul>
</main>
</div>
</body>
</html>
