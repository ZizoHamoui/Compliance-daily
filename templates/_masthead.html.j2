<a class="skip" href="#feed">Skip to stories</a>
<div class="ambient" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
<header class="appbar glass">
  <a class="brand" href="{{ root }}index.html"><span class="brand-mark">T</span><span class="brand-name">{{ paper.name }}</span></a>
  <nav class="navpills" aria-label="Main">
    <a href="{{ root }}index.html"><span class="ms" aria-hidden="true">newspaper</span><span>Today</span></a>
    <a href="{{ root }}saved.html"><span class="ms" aria-hidden="true">bookmarks</span><span>Saved</span><span class="saved-count" aria-label="saved stories"></span></a>
    <a href="{{ root }}archive.html"><span class="ms" aria-hidden="true">calendar_month</span><span>Archive</span></a>
  </nav>
</header>
{% if ed and not hide_hero %}
<section class="hero">
  <div class="hero-meta"><span class="pill-soft">{{ ed.date_long }}</span><span class="pill-soft">Edition No. {{ ed.edition_no }}</span></div>
  <h1 class="nameplate">{{ paper.name }}</h1>
  <p class="mast-tag">{{ paper.tagline }}</p>
  <p class="hero-regions">{{ paper.regions }}</p>
</section>
{% endif %}
