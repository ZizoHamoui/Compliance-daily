{# Persistent audio bar. Rendered on every page; static/nav.js keeps this element (and its audio) alive across page changes. #}
{% if player_ep %}
<aside id="player" class="player" aria-label="Audio briefing" data-ep="{{ player_ep.date }}" data-seconds="{{ player_ep.seconds }}">
  <button class="pl-play" type="button" aria-label="Play {{ player_ep.title }}"><span class="ms" aria-hidden="true">play_arrow</span></button>
  <div class="pl-body">
    <p class="pl-top"><span class="pl-kicker">Audio briefing · {{ player_ep.minutes }} min</span><span class="pl-title">{{ player_ep.title }}</span></p>
    <div class="pl-track">
      <span class="pl-cur">0:00</span>
      <input type="range" class="pl-seek" min="0" max="{{ player_ep.seconds }}" value="0" step="1" aria-label="Position in episode">
      <span class="pl-dur">{{ player_ep.duration }}</span>
    </div>
  </div>
  <div class="pl-tools">
    <button type="button" class="pl-speed" aria-label="Playback speed">1×</button>
    <a class="pl-notes" href="{{ root }}podcast/index.html#ep-{{ player_ep.date }}" title="Show notes"><span class="ms" aria-hidden="true">format_list_bulleted</span><span class="lbl">Notes</span></a>
  </div>
  <audio preload="none" src="{{ root }}podcast/audio/{{ player_ep.file }}"></audio>
</aside>
{% endif %}
